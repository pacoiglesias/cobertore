rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si es Súper Administrador
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email == 'paco.iglesias@gmail.com' || 
        request.auth.token.email == 'paco@cobertores.com' || 
        request.auth.token.email == 'pacoismael@gmail.com'
      );
    }

    // Función para verificar si el usuario tiene privilegios vigentes
    function hasValidPrivilege(roleNeeded) {
      let hasByEmail = request.auth != null && request.auth.token.email != null && exists(/databases/$(database)/documents/user_privileges/$(request.auth.token.email));
      let hasByUid = request.auth != null && exists(/databases/$(database)/documents/user_privileges/$(request.auth.uid));
      let pData = hasByUid ? get(/databases/$(database)/documents/user_privileges/$(request.auth.uid)).data : (hasByEmail ? get(/databases/$(database)/documents/user_privileges/$(request.auth.token.email)).data : null);
      
      return request.auth != null && request.auth.token.email_verified == true && pData != null && 
             (!('expiresAt' in pData) || pData.expiresAt == null || pData.expiresAt > request.time) && 
             (pData.role == roleNeeded || pData.role == 'editor');
    }

    // Reglas para archivos de la intranet
    match /intranet_files/{fileId} {
      // Leer: Súper admin o cualquier persona con privilegio (lector o editor) vigente
      allow read: if isSuperAdmin() || hasValidPrivilege('lector') || hasValidPrivilege('editor');
      // Crear/Borrar/Modificar: Súper admin o cualquier editor vigente
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para gestión de privilegios
    match /user_privileges/{userId} {
      // Leer: Súper Admin ve todo. El usuario solo ve el suyo. (Soporta busqueda por UID y por Email retrocompatible)
      allow read: if isSuperAdmin() || (request.auth != null && (request.auth.token.email == userId || request.auth.uid == userId));
      // Escribir: Solo Súper Admin puede dar o quitar permisos.
      allow write: if isSuperAdmin();
    }

    // Reglas para leads/cotizaciones
    match /leads/{leadId} {
      // ANTI-SPAM: Requerir Firebase App Check (reCAPTCHA) y estructura correcta
      allow create: if request.app != null
                    && request.resource.data.keys().hasAll(['name', 'phone', 'email', 'quantity', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 2
                    && request.resource.data.name.size() < 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 5
                    && request.resource.data.phone.size() < 30
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.email.size() < 100
                    && request.resource.data.quantity is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 1000
                    && !('__honey' in request.resource.data)
                    && !('_honey' in request.resource.data);
                    
      // Solo el súper admin o un editor de la intranet puede leer/borrar cotizaciones
      allow read, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para productos (Catálogo Dinámico)
    match /products/{productId} {
      allow read: if true;
      allow create: if (isSuperAdmin() || hasValidPrivilege('editor'))
                    && request.resource.data.keys().hasAll(['title', 'weight', 'desc', 'imgUrl'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 200;
      allow update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para seguimiento de pedidos
    match /orders/{folio} {
      allow get: if true;
      // FIX: el rol 'almacen' existe del lado del cliente (te manda directo
      // a la pestaña de Pedidos) pero esta regla nunca lo reconocia --
      // cualquier usuario con ese rol se quedaba sin poder ver ni actualizar
      // nada. Se agrega aqui, solo para list/update (dar seguimiento a
      // pedidos), no para create/delete (eso se queda en editor/super admin).
      allow list: if isSuperAdmin() || hasValidPrivilege('editor') || hasValidPrivilege('almacen');
      allow create: if (isSuperAdmin() || hasValidPrivilege('editor'))
                    && request.resource.data.keys().hasAll(['folio', 'clientName', 'status', 'updatedAt'])
                    && request.resource.data.folio is string
                    && request.resource.data.clientName is string
                    && request.resource.data.status is string;
      allow update: if isSuperAdmin() || hasValidPrivilege('editor') || hasValidPrivilege('almacen');
      allow delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para Noticias SEO
    match /news/{newsId} {
      allow read: if true;
      allow create: if (isSuperAdmin() || hasValidPrivilege('editor'))
                    && request.resource.data.keys().hasAll(['title', 'summary'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 500
                    && request.resource.data.summary is string;
      allow update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para documentos oficiales (oficios)
    match /official_documents/{docId} {
      allow read: if isSuperAdmin() || hasValidPrivilege('lector') || hasValidPrivilege('editor');
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para historial de cotizaciones
    match /quotes_history/{quoteId} {
      allow read: if isSuperAdmin() || hasValidPrivilege('lector') || hasValidPrivilege('editor');
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para system_settings (Configuraciones globales)
    match /system_settings/{document=**} {
      // Leer: Público (cualquiera puede ver configuración)
      allow read: if true;
      // Escribir: Solo Súper admin o editor
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }
  }
}
