rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si es Súper Administrador
    // Lista única de súper administradores (C-11: la misma que en storage.rules,
    // functions/src/index.ts y src/app/intranet/dashboard/page.tsx).
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'paco.iglesias@gmail.com' || 
        request.auth.token.email == 'paco@cobertores.com' || 
        request.auth.token.email == 'pacoismael@gmail.com'
      );
    }

    // Función para verificar si el usuario tiene privilegios vigentes
    function hasValidPrivilege(roleNeeded) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/user_privileges/$(request.auth.token.email)) && 
             (get(/databases/$(database)/documents/user_privileges/$(request.auth.token.email)).data.expiresAt == null || 
              get(/databases/$(database)/documents/user_privileges/$(request.auth.token.email)).data.expiresAt > request.time) && 
             (get(/databases/$(database)/documents/user_privileges/$(request.auth.token.email)).data.role == roleNeeded || 
              get(/databases/$(database)/documents/user_privileges/$(request.auth.token.email)).data.role == 'editor');
    }

    // Reglas para archivos de la intranet
    match /intranet_files/{fileId} {
      // Leer: Súper admin o cualquier persona con privilegio (lector o editor) vigente
      allow read: if isSuperAdmin() || hasValidPrivilege('lector') || hasValidPrivilege('editor');
      // Crear/Borrar/Modificar: Súper admin o cualquier editor vigente
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para documentos oficiales (C-10: no tenía regla y fallaba cerrado)
    match /official_documents/{docId} {
      // Leer: Súper admin o cualquier persona con privilegio (lector o editor) vigente
      allow read: if isSuperAdmin() || hasValidPrivilege('lector') || hasValidPrivilege('editor');
      // Crear/Borrar/Modificar: Súper admin o cualquier editor vigente
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para gestión de privilegios
    match /user_privileges/{emailId} {
      // Leer: Súper Admin ve todo. El usuario solo ve el suyo.
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.token.email == emailId);
      // Escribir: Solo Súper Admin puede dar o quitar permisos.
      allow write: if isSuperAdmin();
    }

    // Reglas para leads/cotizaciones
    match /leads/{leadId} {
      // C-1: la creación pública directa está CERRADA. Los leads solo se crean
      // desde la Cloud Function submitLead (Admin SDK, con validación de email
      // y rate-limit por IP en el servidor). El formulario público ya la llama
      // en vez de escribir directo en Firestore. Sin esta regla cualquiera
      // podía crear leads ilimitados con el SDK, saltándose el honeypot y el
      // límite de 5 minutos del navegador.
      // Solo el súper admin o un editor de la intranet puede leer/borrar cotizaciones
      allow read, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para productos (Catálogo Dinámico)
    match /products/{productId} {
      // Leer: Público (cualquiera puede ver el catálogo en la página)
      allow read: if true;
      // Escribir: Súper admin o editor
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para seguimiento de pedidos
    match /orders/{folio} {
      // Leer un pedido específico si sabes el folio (público)
      allow get: if true;
      // Listar no está permitido públicamente para evitar scraping. Solo administradores.
      allow list, create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para Noticias SEO
    match /news/{newsId} {
      // Leer: Público (cualquiera puede ver las noticias)
      allow read: if true;
      // Escribir: Súper admin o editor
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }

    // Reglas para system_settings (C-4)
    // Solo el documento global es de lectura pública: ahí solo deben vivir
    // campos públicos (seoTitle, seoDescription, logoUrl, newsSources) que
    // lee el sitio (layout.tsx) y la función de noticias. Las reglas no
    // pueden restringir la lectura por campo, así que NUNCA se debe guardar
    // un secreto ni un dato interno en system_settings/global.
    match /system_settings/global {
      // Leer: Público (solo este documento)
      allow read: if true;
      // Escribir: Solo Súper admin o editor
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }
    // Cualquier otro documento bajo system_settings es solo para personal
    // con privilegio vigente (antes toda la ruta era de lectura pública).
    match /system_settings/{document} {
      // Leer: Súper admin o cualquier persona con privilegio (lector o editor) vigente
      allow read: if isSuperAdmin() || hasValidPrivilege('lector') || hasValidPrivilege('editor');
      // Escribir: Solo Súper admin o editor
      allow create, update, delete: if isSuperAdmin() || hasValidPrivilege('editor');
    }
  }
}
