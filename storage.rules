rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función para verificar si es Súper Administrador
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'paco.iglesias@gmail.com' || 
        request.auth.token.email == 'paco@cobertores.com' ||
        request.auth.token.email == 'pacoismael@gmail.com'
      );
    }

    // Función para verificar si el usuario tiene rol de editor vigente en Firestore
    function isEditor() {
      return request.auth != null && 
             firestore.exists(/databases/(default)/documents/user_privileges/$(request.auth.token.email)) && 
             (firestore.get(/databases/(default)/documents/user_privileges/$(request.auth.token.email)).data.expiresAt == null || 
              firestore.get(/databases/(default)/documents/user_privileges/$(request.auth.token.email)).data.expiresAt > request.time) &&
             firestore.get(/databases/(default)/documents/user_privileges/$(request.auth.token.email)).data.role == 'editor';
    }

    match /intranet/{allPaths=**} {
      // Permitir leer a cualquier persona autenticada (la app controla qué links ven mediante Firestore)
      allow read: if request.auth != null;
      // Permitir subir solo a súper admins y editores autorizados
      allow write: if isSuperAdmin() || isEditor();
    }

    match /quotes/{allPaths=**} {
      allow read: if true; // El cliente necesita poder descargar el PDF desde el link del correo
      // Solo súper admin o editor generan cotizaciones (igual que el resto de reglas de escritura)
      allow write: if isSuperAdmin() || isEditor();
    }

    match /catalog/{allPaths=**} {
      // Público para que la página web pueda mostrar las fotos
      allow read: if true;
      // Solo usuarios autenticados pueden subir, máximo 5MB, y solo imágenes
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /system_assets/{allPaths=**} {
      // Público para que el frontend pueda cargar el logo
      allow read: if true;
      // Solo administradores pueden subir assets del sistema
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
